# Copy to .env.local and fill in. Nothing here has a secret default.

# Where this site is reached. The session cookie is marked Secure from this, so in production it must
# be the https address people actually use.
PLATFORM_BASE_URL=http://localhost:3000

# Signs session cookies. Required in production; without it sessions end whenever the process does.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PLATFORM_SESSION_SECRET=

# Where the JSON store writes. Back this up: it holds publishers, submissions and token hashes.
PLATFORM_DATA_DIR=data

# Signs you in as a fixed local account, for working on the site before yapin.gg OAuth exists.
# Refused when NODE_ENV=production, which `next start` and `next build` both set — so it only has an
# effect under `next dev`.
PLATFORM_DEV_AUTH=1

# --- Sign in with Yapin' -------------------------------------------------------------------------
# OAuth 2.0 authorization code with PKCE. This site never sees a Yapin' password: it redirects to
# yapin.gg and yapin.gg redirects back with a code. The access token is used for exactly one request,
# to read who signed in, and is then discarded — nothing here touches anyone's account.
#
# The endpoint paths are a guess until Yapin' documents them. Point them at whatever it actually
# serves, or at your own identity provider, without changing any code.
YAPIN_ISSUER=https://yapin.gg
YAPIN_CLIENT_ID=
YAPIN_CLIENT_SECRET=
YAPIN_SCOPE=identify
# YAPIN_AUTHORIZE_URL=https://yapin.gg/oauth2/authorize
# YAPIN_TOKEN_URL=https://yapin.gg/oauth2/token
# YAPIN_USERINFO_URL=https://yapin.gg/api/v1/users/@me

# --- The index this platform feeds ----------------------------------------------------------------
REGISTRY_REPO=yapin-js/yapin.js-client-plugins
REGISTRY_INDEX_URL=https://plugins.yapin.dev/index.json
